// Password spray that worked: successful sign-ins from spraying IPs
// ------------------------------------------------------------------
// What it finds: successful sign-ins from any IP address that was
//   spraying in the same window. A spray that lands a success is the
//   one that matters; this is the query to alert on.
// Table: SigninLogs
// MITRE ATT&CK: T1110.003 Brute Force: Password Spraying
// Written up in: https://alanconlon.com/posts/hunting-password-spray-kql/
// ------------------------------------------------------------------
let Lookback = 1d;           // how far back to look
let Threshold = 15;          // distinct accounts before a source counts as spraying
// Step 1: source IPs failing against many distinct accounts
let SprayIPs = SigninLogs
    | where TimeGenerated > ago(Lookback)
    | where ResultType == 50126
    | summarize DistinctUsers = dcount(UserPrincipalName) by IPAddress
    | where DistinctUsers >= Threshold;
// Step 2: any successful sign-in from those same IPs
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ResultType == 0
| join kind=inner SprayIPs on IPAddress
| project TimeGenerated, UserPrincipalName, IPAddress,
    DistinctUsers, Location, AppDisplayName
| sort by TimeGenerated desc
