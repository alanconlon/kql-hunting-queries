// Password spray: one source failing against many accounts
// ------------------------------------------------------------------
// What it finds: IP addresses that hit "invalid password" against a
//   wide spread of distinct accounts in an hour. Brute force is many
//   tries on one account; spray is one or two tries on many, so the
//   signal is the count of distinct users, not the count of failures.
// Table: SigninLogs
// MITRE ATT&CK: T1110.003 Brute Force: Password Spraying
// Written up in: https://alanconlon.com/posts/hunting-password-spray-kql/
// ------------------------------------------------------------------
let Lookback = 1d;           // how far back to look
let Window = 1h;             // size of each time bucket
let Threshold = 15;          // distinct accounts per source per bucket
SigninLogs
| where TimeGenerated > ago(Lookback)
| where ResultType == "50126"               // 50126 = invalid username or password
| summarize
    DistinctUsers = dcount(UserPrincipalName),
    Attempts = count()
    by IPAddress, bin(TimeGenerated, Window)
| where DistinctUsers >= Threshold
| sort by DistinctUsers desc
